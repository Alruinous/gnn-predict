# V100/A100: official 8B batch-1 and batch-2 decode coverage.
- base_model:
    name: qwen3
    pretrained: false
  variant_config_grid:
    base_variant_config_template:
      example_input_shape:
      - 1
      - 64
      run_training: false
      run_inference: false
      run_prefill: false
      run_decode: true
      pre_inference_cooldown_seconds: 5.0
      pre_prefill_cooldown_seconds: 5.0
      pre_decode_cooldown_seconds: 5.0
      inference_measurement_min_seconds: 40.0
      prefill_measurement_min_seconds: 40.0
      decode_measurement_min_seconds: 40.0
      decode_max_output_length: 16
      export_onnx: true
      onnx_export_mode: architecture_only
      batch_size: 1
      training_measurement_min_seconds: 40.0
      use_fake_text_dataset: true
      qwen3_config:
        vocab_size: 151936
        hidden_size: 4096
        intermediate_size: 12288
        num_hidden_layers: 36
        num_attention_heads: 32
        num_key_value_heads: 8
        head_dim: 128
        max_position_embeddings: 40960
        tie_word_embeddings: false
        rope_parameters:
          rope_theta: 1000000.0
          rope_type: default
