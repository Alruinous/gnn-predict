base_model_groups:
# Keep all V100/A100 groups and comment every A100-only group when running on V100.
# A100-only arch names are distinct so the full file can be validated without duplicate variant names.
# Qwen3-32B is excluded because the generator uses one GPU and the available A100 has 40GB.
# V100/A100: official 0.6B, 1.7B and 4B prefill coverage.
- base_model:
    name: qwen3
    pretrained: false
  variant_config_grid:
    base_variant_config_template:
      example_input_shape:
      - 1
      - 64
      run_training: false
      run_inference: false
      run_prefill: true
      run_decode: false
      pre_inference_cooldown_seconds: 5.0
      pre_prefill_cooldown_seconds: 5.0
      pre_decode_cooldown_seconds: 5.0
      inference_measurement_min_seconds: 40.0
      prefill_measurement_min_seconds: 40.0
      decode_measurement_min_seconds: 40.0
      decode_max_output_length: 0
      export_onnx: true
      onnx_export_mode: architecture_only
      batch_size: 1
      training_measurement_min_seconds: 40.0
      use_fake_text_dataset: true
      qwen3_config:
        vocab_size: 151936
        hidden_size: 1024
        intermediate_size: 3072
        num_hidden_layers: 28
        num_attention_heads: 16
        num_key_value_heads: 8
        head_dim: 128
        max_position_embeddings: 40960
        tie_word_embeddings: true
        rope_parameters:
          rope_theta: 1000000.0
          rope_type: default
    axes:
    - name: arch
      values:
      - name: official_0_6b
        overrides:
          qwen3_config.vocab_size: 151936
          qwen3_config.hidden_size: 1024
          qwen3_config.intermediate_size: 3072
          qwen3_config.num_hidden_layers: 28
          qwen3_config.num_attention_heads: 16
          qwen3_config.num_key_value_heads: 8
          qwen3_config.head_dim: 128
          qwen3_config.max_position_embeddings: 40960
          qwen3_config.tie_word_embeddings: true
      - name: official_1_7b
        overrides:
          qwen3_config.vocab_size: 151936
          qwen3_config.hidden_size: 2048
          qwen3_config.intermediate_size: 6144
          qwen3_config.num_hidden_layers: 28
          qwen3_config.num_attention_heads: 16
          qwen3_config.num_key_value_heads: 8
          qwen3_config.head_dim: 128
          qwen3_config.max_position_embeddings: 40960
          qwen3_config.tie_word_embeddings: true
      - name: official_4b
        overrides:
          qwen3_config.vocab_size: 151936
          qwen3_config.hidden_size: 2560
          qwen3_config.intermediate_size: 9728
          qwen3_config.num_hidden_layers: 36
          qwen3_config.num_attention_heads: 32
          qwen3_config.num_key_value_heads: 8
          qwen3_config.head_dim: 128
          qwen3_config.max_position_embeddings: 40960
          qwen3_config.tie_word_embeddings: true
    - name: shape
      values:
      - name: bs1_s64
        overrides:
          example_input_shape:
          - 1
          - 64
          batch_size: 1
      - name: bs1_s128
        overrides:
          example_input_shape:
          - 1
          - 128
          batch_size: 1
      - name: bs1_s192
        overrides:
          example_input_shape:
          - 1
          - 192
          batch_size: 1
      - name: bs1_s256
        overrides:
          example_input_shape:
          - 1
